<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="#8A8A8A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_margin="50dp"
        android:textColor="@color/white"/>

    <EditText android:id="@+id/edt_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Informe o seu nome"
        android:inputType="textPersonName"
        android:layout_margin="20dp"
        android:background="@color/white"
        android:padding="15dp"/>

    <EditText android:id="@+id/edt_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Informe o seu Email"
        android:inputType="textEmailAddress"
        android:layout_margin="20dp"
        android:background="@color/white"
        android:padding="15dp"/>

    <EditText android:id="@+id/edt_senha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Informe a sua Senha"
        android:inputType="textPassword"
        android:layout_margin="20dp"
        android:background="@color/white"
        android:padding="15dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp">

        <Button android:id="@+id/btn_entrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrar"
            app:cornerRadius="10dp"
            android:backgroundTint="#DC1C1C"
            android:padding="12sp"
            android:textSize="18dp"/>

        <Button android:id="@+id/btn_criar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Criar"
            android:layout_marginStart="20dp"
            app:cornerRadius="10dp"
            android:backgroundTint="#454343"
            android:padding="12dp"
            android:textSize="18dp"/>
    </LinearLayout>

    <Button android:id="@+id/btn_limpar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limpar Credenciais"
        app:cornerRadius="10dp"
        android:backgroundTint="#32A6A6"
        android:padding="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:textSize="18dp"/>

        <CheckBox android:id="@+id/btn_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:buttonTint="@color/white"
            android:text="Lembrar minhas Credenciais"
            android:textColor="@color/white"
            android:textSize="17dp"/>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:src="@drawable/teste"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        />
</LinearLayout>

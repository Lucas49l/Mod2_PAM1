<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:padding="20dp"
    android:background="@color/fundo">

    <TextView android:id="@+id/txt_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:text="Calcular Média"
        android:textAlignment="center"
        android:textSize="40dp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed-light"
        android:textColor="@color/botao"/>

    <EditText android:id="@+id/edt_nota1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/txt_titulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="50dp"
        android:padding="20dp"
        android:hint="Nota 1"
        android:inputType="number"
        android:textAlignment="center"
        android:background="@color/campo"/>

    <EditText android:id="@+id/edt_nota2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/txt_titulo"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="50dp"
        android:padding="20dp"
        android:hint="Nota 2"
        android:inputType="number"
        android:textAlignment="center"
        android:background="@color/campo"/>

    <EditText android:id="@+id/edt_nota3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/edt_nota1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="50dp"
        android:padding="20dp"
        android:hint="Nota 3"
        android:inputType="number"
        android:textAlignment="center"
        android:background="@color/campo"/>

    <EditText android:id="@+id/edt_nota4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/edt_nota2"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="50dp"
        android:padding="20dp"
        android:hint="Nota 4"
        android:inputType="number"
        android:textAlignment="center"
        android:background="@color/campo"/>

    <EditText android:id="@+id/edt_faltas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/edt_nota3"
        android:layout_marginTop="30dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:background="@color/campo"
        android:padding="15dp"
        android:hint="Número de faltas"
        android:inputType="number"
        android:textAlignment="center"/>

    <Button android:id="@+id/btn_calcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/edt_faltas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="15dp"
        android:backgroundTint="@color/botao"
        android:text="Calcular"
        android:textSize="20dp"
        app:cornerRadius="0dp"/>

    <TextView android:id="@+id/txt_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/btn_calcular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="20dp"
        android:background="@color/campo"
        android:layout_marginTop="50dp"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:textSize="24sp"
        android:gravity="center"
        android:textStyle="bold"/>

</androidx.constraintlayout.widget.ConstraintLayout>